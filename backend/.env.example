# Порт, на котором слушает backend
PORT=3000

# Своя локальная PostgreSQL (не Supabase!)
DATABASE_URL=postgresql://rift:rift_password@postgres:5432/rift

# Секрет для подписи JWT админ-сессий — обязательно смени на случайную строку
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# URL demo-parser сервиса (Python/FastAPI)
DEMO_PARSER_URL=http://demo-parser:8001

# Куда сохранять загруженные .dem файлы. Для локального запуска (npm run dev) —
# относительный путь; в docker-compose.yml переопределяется на /app/backend/uploads.
UPLOADS_DIR=./uploads

# CORS — адрес фронтенда (через запятую, если несколько)
CORS_ORIGIN=http://localhost:5173

# K-фактор для расчёта изменения рейтинга (ELO-подобного)
RATING_K_FACTOR=30
